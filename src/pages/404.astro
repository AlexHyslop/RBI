---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---

<Base
  title="Page Not Found"
  description="That page does not exist. Try the main sections of the RB Interiors (Kent) website."
>
  <section class="nf">
    <div class="wrap nf__inner">
      <p class="eyebrow">Error 404</p>
      <h1 class="nf__title">That page has been stripped out.</h1>
      <p class="prose">
        Nothing here. The link may be out of date, or the page may have moved
        when the site was rebuilt.
      </p>
      <ul class="nf__links">
        {nav.map((item) => <li><a class="btn" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 10vw, 8rem); }
  .nf__inner { display: grid; justify-items: start; gap: 1.5rem; }
  .nf__title { font-size: var(--step-4); max-width: 16ch; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
</style>
