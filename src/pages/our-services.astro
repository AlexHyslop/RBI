---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SectorTiles from '../components/SectorTiles.astro';
import { company, services } from '../data/site';
---

<Base
  title="Our Services"
  description="Plumbing and heating, painting and decorating, refurbishment, bathrooms and showers, suspended ceilings, partitioning, joinery and carpentry and flooring, across the South East."
>
  <PageBanner
    title="Our Services"
    lede={company.tagline}
    photo="/photos/refurbishment.jpg"
  />

  <nav class="jump" aria-label="Jump to a service">
    <ul class="wrap jump__inner">
      {services.map((s) => (
        <li><a href={`#${s.slug}`}>{s.title}</a></li>
      ))}
    </ul>
  </nav>

  {services.map((s, i) => (
    <section id={s.slug} class:list={['svc', i % 2 === 1 && 'svc--alt']}>
      <div class="wrap svc__inner" data-reveal>
        <div class="svc__text">
          <p class="eyebrow">{String(i + 1).padStart(2, '0')} — Service</p>
          <h2 class="svc__title">{s.title}</h2>
          <p class="svc__sum">{s.summary}</p>
          {s.body.map((p) => <p class="prose">{p}</p>)}
          <a class="btn" href="/contact-us/">
            Ask about this <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>

        {s.photo ? (
          <img
            class="svc__photo"
            src={s.photo}
            alt=""
            width="1400"
            height="933"
            loading="lazy"
          />
        ) : (
          <div class="svc__mark" aria-hidden="true">
            <span>{String(i + 1).padStart(2, '0')}</span>
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap shead" data-reveal>
      <h2 class="shead__title">
        The sectors <span class="shead__accent">we work in</span>
      </h2>
      <p class="prose">
        The trades do not change much between a school and a warehouse. The
        constraints do — who is in the building, when we can be noisy, and
        which date is immovable.
      </p>
    </div>
    <SectorTiles />
  </section>

  <section class="section section--grey">
    <div class="wrap cta" data-reveal>
      <h2 class="cta__title">Not sure which of those you need?</h2>
      <p class="cta__copy">
        Most people describe the problem rather than the trade — a floor that
        keeps lifting, a room that is too loud, a washroom past saving. Tell us
        the problem and we will tell you what the work actually is.
      </p>
      <div class="cta__actions">
        <a class="btn btn--light" href="/contact-us/">
          Contact Us <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="cta__tel" href={company.phoneHref}>or call {company.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: var(--navy);
    color: var(--white);
  }

  /* Narrow screens scroll the list sideways; the fade on the right edge is
     the only hint that there is more, since the scrollbar is hidden. */
  .jump::after {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 3.5rem;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--navy) 70%);
  }

  .jump__inner {
    display: flex;
    gap: 0.6rem clamp(1rem, 2.2vw, 2rem);
    overflow-x: auto;
    padding-block: 1rem;
    scrollbar-width: none;
  }
  .jump__inner::-webkit-scrollbar { display: none; }

  /* Wide enough to wrap: all eight stay visible, two rows if need be,
     rather than the last one being cut off beyond the right edge. */
  @media (min-width: 62rem) {
    .jump::after { display: none; }
    .jump__inner { flex-wrap: wrap; overflow-x: visible; }
  }

  .jump a {
    white-space: nowrap;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.78;
    transition: opacity 0.2s var(--ease);
  }
  .jump a:hover { opacity: 1; }

  .svc {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    scroll-margin-top: calc(var(--header-h) + 3.5rem);
  }

  .svc--alt { background: var(--off); }

  .svc__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .svc__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    /* Alternate which side the picture falls on down the page. */
    .svc--alt .svc__text { order: 2; }
  }

  .svc__text { display: grid; justify-items: start; gap: 1.25rem; }
  .svc__text .eyebrow { margin-bottom: 0; }

  .svc__title { font-size: var(--step-3); }

  .svc__sum {
    margin: 0;
    max-width: 38ch;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.4;
    color: var(--navy);
  }

  .svc__text .prose { margin: 0; }
  .svc__text .btn { margin-top: 0.75rem; }

  .svc__photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .svc__mark {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    background: var(--navy);
    color: rgba(255, 255, 255, 0.16);
  }

  .svc__mark span {
    font-size: clamp(6rem, 16vw, 13rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .shead {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 62rem) {
    .shead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
  }

  .shead__title { font-size: var(--step-3); max-width: 14ch; }
  .shead__accent { color: var(--navy); }

  .cta { display: grid; justify-items: start; gap: 1.5rem; }
  .cta__title { font-size: var(--step-3); max-width: 18ch; }
  .cta__copy { max-width: 52ch; font-size: var(--step-1); font-weight: 500; opacity: 0.9; }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }

  .cta__tel { font-weight: 700; opacity: 0.85; }
  .cta__tel:hover { opacity: 1; text-decoration: underline; text-underline-offset: 0.3em; }

  .btn__arrow { display: inline-block; }
</style>
