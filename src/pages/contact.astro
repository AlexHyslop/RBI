---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { company, services } from '../data/site';

/**
 * Set this to a POST endpoint (Formspree, Vercel function, CRM webhook) to have
 * enquiries delivered server-side. While it is empty the form falls back to
 * composing an email in the visitor's own mail client, so it still works.
 */
const FORM_ENDPOINT = '';
---

<Base
  title="Contact"
  description="Contact RB Interiors (Kent) Limited — Kemsley, Sittingbourne. Call 020 3903 8644 or send details of your project for a written quotation."
>
  <PageHero
    eyebrow="Contact"
    title="Tell us about the building."
    lede="A drawing, a schedule of works, or three photographs taken on your phone — any of those is enough to start with. We will come and look before we price anything substantial."
  />

  <section class="section">
    <div class="wrap contact">
      <div class="contact__details">
        <dl class="cd">
          <div class="cd__row">
            <dt>Telephone</dt>
            <dd><a href={company.phoneHref}>{company.phone}</a></dd>
          </div>
          <div class="cd__row">
            <dt>Email</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div class="cd__row">
            <dt>Office</dt>
            <dd>
              <address>
                {company.address.line1}<br />
                {company.address.line2}<br />
                {company.address.county} {company.address.postcode}
              </address>
            </dd>
          </div>
          <div class="cd__row">
            <dt>Hours</dt>
            <dd>{company.hours}</dd>
          </div>
          <div class="cd__row">
            <dt>Coverage</dt>
            <dd>Kent, South and East London, and the wider South East</dd>
          </div>
        </dl>

        <div class="urgent hatch">
          <p class="label label--plain">Already on site and stuck?</p>
          <p class="urgent__copy">
            If something has failed and the building is out of use, call rather
            than email. Someone in the office picks up between 7.30 and 5.30.
          </p>
          <a class="btn" href={company.phoneHref}>
            {company.phone} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="contact__form">
        <h2 class="form__head">Send project details</h2>

        <form
          class="form"
          method="post"
          action={FORM_ENDPOINT || undefined}
          data-fallback-email={FORM_ENDPOINT ? undefined : company.email}
          novalidate={false}
        >
          <div class="form__grid">
            <p class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </p>
            <p class="field">
              <label for="org">Company or organisation <span>(optional)</span></label>
              <input id="org" name="organisation" type="text" autocomplete="organization" />
            </p>
            <p class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </p>
            <p class="field">
              <label for="tel">Telephone</label>
              <input id="tel" name="telephone" type="tel" autocomplete="tel" />
            </p>
            <p class="field field--wide">
              <label for="site">Site address or postcode</label>
              <input id="site" name="site" type="text" />
            </p>
            <p class="field field--wide">
              <label for="work">What is the work?</label>
              <select id="work" name="work">
                <option value="">Not sure yet</option>
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
                <option value="Several of the above">Several of the above</option>
              </select>
            </p>
            <p class="field field--wide">
              <label for="message">Details</label>
              <textarea id="message" name="message" rows="6" required
                placeholder="Rough size, condition, any dates that are fixed, and whether the building stays in use while the work happens."></textarea>
            </p>
          </div>

          <div class="form__foot">
            <button class="btn" type="submit">
              Send enquiry <span class="btn__arrow" aria-hidden="true">→</span>
            </button>
            <p class="form__note">
              We reply to everything within one working day. Your details are
              used to answer the enquiry and nothing else.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  /* With no POST endpoint configured, hand the enquiry to the visitor's own
     mail client rather than silently losing it. */
  const form = document.querySelector<HTMLFormElement>('form[data-fallback-email]');
  const to = form?.dataset.fallbackEmail;

  if (form && to) {
    form.addEventListener('submit', (event) => {
      if (!form.reportValidity()) return;
      event.preventDefault();

      const data = new FormData(form);
      const body = [...data.entries()]
        .filter(([, value]) => String(value).trim() !== '')
        .map(([key, value]) => `${key[0].toUpperCase()}${key.slice(1)}: ${value}`)
        .join('\n\n');

      const subject = `Website enquiry — ${data.get('work') || 'general'}`;
      window.location.href =
        `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>

<style>
  .contact { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: start; }

  @media (min-width: 64rem) {
    .contact { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  }

  .cd { margin: 0; border-top: 1px solid var(--rule); }

  .cd__row {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 30rem) {
    .cd__row {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .cd__row dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cd__row dd { margin: 0; }
  .cd__row address { font-style: normal; line-height: 1.6; }

  .urgent {
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--rule);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .urgent__copy {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 38ch;
  }

  .form__head {
    font-size: var(--step-2);
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .form__grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .form__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field--wide { grid-column: 1 / -1; }
  }

  .field { margin: 0; display: grid; gap: 0.5rem; }

  .field label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .field label span { color: var(--ink-3); letter-spacing: 0.08em; }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 0;
    font-family: var(--sans);
    font-size: var(--step-0);
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .field textarea { resize: vertical; line-height: 1.55; }

  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-color: var(--ink-3); }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .field ::placeholder { color: var(--ink-3); opacity: 1; }

  .form__foot {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    justify-items: start;
  }

  .form__note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 48ch;
  }
</style>
