---
import Base from '../layouts/Base.astro';
import SectorTiles from '../components/SectorTiles.astro';
import ContactForm from '../components/ContactForm.astro';
import { company, services } from '../data/site';
---

<Base
  title="Building & Refurbishment"
  description={company.tagline}
  overlayHeader
>
  <!-- ── hero ─────────────────────────────────────────────── -->
  <section class="hero">
    <img
      class="hero__img"
      src="/photos/hero.jpg"
      alt=""
      width="2200"
      height="1238"
      fetchpriority="high"
    />
    <div class="hero__scrim"></div>

    <div class="wrap hero__inner">
      <h1 class="hero__title">{company.name}</h1>
      <p class="hero__lede">{company.tagline}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href="/our-services/">
          View Our Services <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--outline-light" href="/contact-us/">Contact Us</a>
      </div>
    </div>

    <a class="hero__scroll" href="#intro" aria-label="Scroll to content">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ── statement ────────────────────────────────────────── -->
  <section class="section" id="intro">
    <div class="wrap intro" data-reveal>
      <p class="statement">
        <strong>RB Interiors is a building and refurbishment company,</strong>{' '}
        working across the South East with more than twenty years behind it and
        eight of the trades a refurbishment needs kept in-house.
      </p>
      <div class="intro__side">
        <p class="prose">
          {company.tagline} From a single bathroom to a whole floor stripped
          back and rebuilt, the work is run as one contract with one person to
          call — which is usually the difference between a programme that holds
          and one that drifts.
        </p>
        <p class="intro__years">{company.years}</p>
      </div>
    </div>
  </section>

  <!-- ── sectors ──────────────────────────────────────────── -->
  <section class="section--tight">
    <SectorTiles />
  </section>

  <!-- ── services ─────────────────────────────────────────── -->
  <section class="section section--off" id="services">
    <div class="wrap">
      <div class="shead" data-reveal>
        <h2 class="shead__title">
          What Can We Do <span class="shead__accent">For You?</span>
        </h2>
        <p class="prose shead__copy">
          Eight trades, all of them ours. Most jobs use three or four at once,
          which is exactly why they are worth keeping under one roof.
        </p>
      </div>

      <ul class="srv">
        {services.map((s) => (
          <li class="srv__item" data-reveal>
            <a class="srv__link" href={`/our-services/#${s.slug}`}>
              <h3 class="srv__title">{s.title}</h3>
              <p class="srv__copy">{s.summary}</p>
              <span class="srv__more">
                Read more <span class="btn__arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── band ─────────────────────────────────────────────── -->
  <section class="band" aria-hidden="true">
    <img
      class="band__img"
      src="/photos/band.jpg"
      alt=""
      width="2000"
      height="857"
      loading="lazy"
    />
  </section>

  <!-- ── contact ──────────────────────────────────────────── -->
  <section class="section section--grey" id="contact">
    <div class="wrap contact">
      <div data-reveal>
        <p class="eyebrow">Contact Us</p>
        <h2 class="contact__title">Tell us about the building.</h2>
        <p class="contact__copy">
          A drawing, a schedule of works, or a few photographs taken on your
          phone — any of those is enough to start a conversation.
        </p>

        <dl class="contact__details">
          <div>
            <dt>Telephone</dt>
            <dd><a href={company.phoneHref}>{company.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>Area covered</dt>
            <dd>{company.area}</dd>
          </div>
        </dl>
      </div>

      <div data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero ------------------------------------------------------- */

  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__img,
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__img { width: 100%; height: 100%; object-fit: cover; }

  .hero__scrim {
    background: linear-gradient(
      180deg,
      rgba(21, 41, 80, 0.78) 0%,
      rgba(21, 41, 80, 0.55) 40%,
      rgba(21, 41, 80, 0.88) 100%
    );
  }

  .hero__inner {
    color: var(--white);
    padding-block: calc(var(--header-h) + 3rem) 7rem;
    max-width: 68rem;
  }

  .hero__title {
    font-size: var(--step-5);
    line-height: 1.02;
    text-transform: uppercase;
    max-width: 15ch;
  }

  .hero__lede {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    max-width: 48ch;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    color: var(--white);
    font-size: 1.1rem;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
    animation: nudge 2.6s var(--ease) infinite;
  }

  .hero__scroll:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: var(--white);
  }

  @keyframes nudge {
    0%, 70%, 100% { translate: -50% 0; }
    85% { translate: -50% 0.45rem; }
  }

  @media (max-width: 48rem) {
    .hero__scroll { display: none; }
  }

  /* intro ------------------------------------------------------ */

  .intro {
    display: grid;
    gap: clamp(2rem, 4vw, 4.5rem);
  }

  @media (min-width: 62rem) {
    .intro { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  }

  .intro__side { display: grid; align-content: start; gap: 1.75rem; }

  .intro__years {
    margin: 0;
    padding-top: 1.75rem;
    border-top: 2px solid var(--grey-line);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--navy);
  }

  /* services --------------------------------------------------- */

  .shead {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 62rem) {
    .shead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
  }

  .shead__title { font-size: var(--step-3); max-width: 14ch; }
  .shead__accent { color: var(--navy); }
  .shead__copy { padding-bottom: 0.35rem; }

  .srv {
    display: grid;
    gap: 2px;
    background: var(--grey-line);
    border: 2px solid var(--grey-line);
  }

  @media (min-width: 42rem) { .srv { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .srv { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .srv__item { background: var(--white); }

  .srv__link {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    height: 100%;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    transition: background 0.25s var(--ease);
  }

  .srv__link:hover { background: var(--navy); }

  .srv__title { font-size: var(--step-1); color: var(--navy); }
  .srv__link:hover .srv__title { color: var(--white); }

  .srv__copy {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--grey);
  }
  .srv__link:hover .srv__copy { color: rgba(255, 255, 255, 0.85); }

  .srv__more {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .srv__link:hover .srv__more { color: var(--white); }
  .srv__link:hover .btn__arrow { translate: 0.3em 0; }
  .btn__arrow { display: inline-block; transition: translate 0.25s var(--ease); }

  /* band ------------------------------------------------------- */

  .band { display: block; }
  .band__img {
    width: 100%;
    height: clamp(14rem, 28vw, 24rem);
    object-fit: cover;
  }

  /* contact ---------------------------------------------------- */

  .contact {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .contact { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .contact__title { font-size: var(--step-3); max-width: 16ch; }

  .contact__copy {
    margin: 1.5rem 0 2.5rem;
    max-width: 44ch;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.5;
    opacity: 0.9;
  }

  .contact__details { display: grid; gap: 0; margin: 0; }

  .contact__details > div {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  @media (min-width: 30rem) {
    .contact__details > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .contact__details dt {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .contact__details dd {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
  }

  .contact__details a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
</style>
