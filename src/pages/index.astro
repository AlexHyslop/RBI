---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import CallToAction from '../components/CallToAction.astro';
import { company, services, sectors, process } from '../data/site';

const facts = [
  { k: '20+', v: 'Years on site' },
  { k: '7', v: 'Trades in-house' },
  { k: '4', v: 'Sectors served' },
  { k: 'ME10', v: 'Kemsley yard' },
];
---

<Base
  title="Building & interior contractors in Kent"
  description="RB Interiors (Kent) Limited — refurbishment, fit-out, partitioning, joinery, flooring, plumbing and decoration across Kent, London and the South East. Over twenty years on site."
>
  <!-- ── hero ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap">
      <p class="label">{company.legalName} · Kemsley, Kent</p>

      <div class="hero__grid">
        <h1 class="hero__title">
          We refurbish<br />
          buildings that<br />
          have to <em>keep</em><br />
          working.
        </h1>

        <div class="hero__aside">
          <p class="hero__lede">
            Seven trades under one roof, run as a single contract. Offices,
            schools, industrial units and private houses across Kent, London
            and the South East — for over twenty years.
          </p>
          <div class="hero__actions">
            <a class="btn" href="/contact/">
              Request a quotation <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href="/services/">What we do</a>
          </div>
        </div>
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {facts.map((f) => (
          <div class="facts__item">
            <dt class="facts__k">{f.k}</dt>
            <dd class="facts__v">{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── statement ────────────────────────────────────────── -->
  <section class="section ruled">
    <div class="wrap statement">
      <div class="statement__side">
        <p class="label">01 / The short version</p>
      </div>
      <div class="statement__body">
        <p class="lede">
          Most contractors subcontract everything and manage the gaps. We employ
          our trades, so the gaps are ours to close.
        </p>
        <div class="statement__cols">
          <p>
            RB Interiors has been working out of Kemsley since 2012, and the
            people running it were on site a decade before that. The work is
            refurbishment and fit-out: taking a building that is tired, badly
            laid out or simply worn through, and putting it back into service.
          </p>
          <p>
            That often means working around people. A school has six weeks in
            August. An office has a lease date. A warehouse cannot stop picking.
            So the programme gets written first, around the dates that actually
            matter, and then we work to it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── services ─────────────────────────────────────────── -->
  <section class="section ruled" id="services">
    <div class="wrap">
      <div class="shead">
        <p class="label">02 / Services</p>
        <h2 class="shead__title">Seven trades, one contract, one invoice.</h2>
      </div>

      <ul class="srv">
        {services.map((s) => (
          <li class="srv__row">
            <a class="srv__link" href={`/services/#${s.slug}`}>
              <span class="num srv__n">{s.n}</span>
              <span class="srv__title">{s.title}</span>
              <span class="srv__sum">{s.summary}</span>
              <span class="srv__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── sectors ──────────────────────────────────────────── -->
  <section class="section ruled">
    <div class="wrap">
      <div class="shead">
        <p class="label">03 / Sectors</p>
        <h2 class="shead__title">Where the work happens.</h2>
      </div>

      <div class="sect">
        {sectors.map((s) => (
          <article class="sect__card">
            <span class="num">{s.n}</span>
            <h3 class="sect__title">{s.title}</h3>
            <p class="sect__copy">{s.copy}</p>
            <ul class="sect__points">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <p class="sect__more">
        <a href="/sectors/">More on how each sector is handled →</a>
      </p>
    </div>
  </section>

  <!-- ── quote ────────────────────────────────────────────── -->
  <section class="section ink-panel">
    <div class="wrap quote">
      <blockquote class="quote__q">
        <p>
          “Three washroom blocks, stripped and rebuilt inside the summer
          holiday. Back open on the first day of term, which is the only date
          that was ever going to count.”
        </p>
      </blockquote>
      <footer class="quote__by">
        <p class="label">Site manager, secondary school · Medway</p>
      </footer>
    </div>
  </section>

  <!-- ── process ──────────────────────────────────────────── -->
  <section class="section ruled">
    <div class="wrap">
      <div class="shead">
        <p class="label">04 / How we work</p>
        <h2 class="shead__title">Five stages, no surprises in the middle.</h2>
      </div>

      <ol class="steps">
        {process.map((p) => (
          <li class="steps__item">
            <span class="num">{p.n}</span>
            <h3 class="steps__title">{p.title}</h3>
            <p class="steps__copy">{p.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── coverage ─────────────────────────────────────────── -->
  <section class="section ruled">
    <div class="wrap cover">
      <div class="cover__text">
        <p class="label">05 / Coverage</p>
        <h2 class="cover__title">Kent, London, and as far as the job justifies.</h2>
        <p class="prose">
          The yard is in Kemsley, just off the M2 at Sittingbourne. Day-to-day
          that means Medway, Swale, Canterbury, Maidstone, Thanet, Ashford and
          the Dartford corridor into South and East London. We will travel
          further for a programme that warrants it — ask.
        </p>
        <ul class="cover__list">
          <li>Sittingbourne</li><li>Medway</li><li>Maidstone</li>
          <li>Canterbury</li><li>Ashford</li><li>Thanet</li>
          <li>Dartford</li><li>Bromley</li><li>South London</li>
        </ul>
      </div>
      <Figure
        caption="Fig. 01 — Washroom strip-out, Medway. Photograph to be supplied."
        ratio="5 / 4"
      />
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  /* hero */
  .hero { padding-block: clamp(3rem, 7vw, 7rem) 0; }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(1.75rem, 3vw, 3rem);
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
  }

  .hero__title {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .hero__title em {
    font-style: normal;
    color: var(--accent);
  }

  .hero__aside { display: grid; gap: 2rem; padding-bottom: 0.5rem; }

  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--ink-2);
    max-width: 42ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(3rem, 6vw, 5.5rem) 0 0;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .facts__item {
    padding: 1.5rem 1.25rem 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .facts__item { border-bottom: 0; }
    .facts__item + .facts__item {
      padding-left: clamp(1rem, 2vw, 2rem);
      border-left: 1px solid var(--rule);
    }
  }

  .facts__k {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .facts__v {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* section heading */
  .shead {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 60rem) {
    .shead {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: baseline;
      gap: 3rem;
    }
  }

  .shead__title {
    font-size: var(--step-3);
    max-width: 26ch;
  }

  /* statement */
  .statement { display: grid; gap: 1.5rem; }

  @media (min-width: 60rem) {
    .statement { grid-template-columns: 14rem minmax(0, 1fr); gap: 3rem; }
  }

  .statement__body { display: grid; gap: 2.5rem; }

  .statement__cols {
    display: grid;
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    color: var(--ink-2);
  }

  @media (min-width: 48rem) {
    .statement__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* services list */
  .srv { border-top: 1px solid var(--rule); }

  .srv__row { border-bottom: 1px solid var(--rule); }

  .srv__link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 2rem;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding: 1.4rem 0;
    text-decoration: none;
    transition: padding-inline 0.2s ease, background 0.2s ease;
  }

  @media (min-width: 60rem) {
    .srv__link {
      grid-template-columns: 4.5rem minmax(0, 0.9fr) minmax(0, 1.1fr) 3rem;
      align-items: center;
      padding: 1.6rem 0;
    }
  }

  .srv__link:hover {
    background: var(--paper-2);
    padding-inline: clamp(0.5rem, 1.5vw, 1.25rem);
  }

  .srv__n { grid-row: 1; }

  .srv__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .srv__link:hover .srv__title { color: var(--accent-ink); }

  .srv__sum {
    grid-column: 2 / -1;
    color: var(--ink-3);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  @media (min-width: 60rem) {
    .srv__sum { grid-column: auto; font-size: var(--step-0); }
  }

  .srv__arrow {
    display: none;
    justify-self: end;
    color: var(--accent);
    transition: translate 0.2s ease;
  }

  @media (min-width: 60rem) { .srv__arrow { display: block; } }
  .srv__link:hover .srv__arrow { translate: 0.35em 0; }

  /* sectors */
  .sect {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  @media (min-width: 44rem) { .sect { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .sect { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .sect__card {
    background: var(--paper);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .sect__title { font-size: var(--step-1); }

  .sect__copy { color: var(--ink-2); font-size: var(--step--1); line-height: 1.6; }

  .sect__points {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .sect__points li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .sect__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--accent);
  }

  .sect__more {
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* quote */
  .quote { display: grid; gap: 2rem; }

  .quote__q { margin: 0; }

  .quote__q p {
    font-size: var(--step-3);
    line-height: 1.22;
    letter-spacing: -0.03em;
    font-weight: 500;
    max-width: 30ch;
    text-indent: -0.4em;
  }

  .quote__by { margin: 0; }

  /* process */
  .steps {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }

  @media (min-width: 44rem) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* odd number of steps — let the last one run the full width rather than
       leaving a hole in the grid */
    .steps__item:last-child { grid-column: 1 / -1; }
  }

  @media (min-width: 76rem) {
    .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .steps__item:last-child { grid-column: auto; }
  }

  .steps__item {
    background: var(--paper);
    padding: clamp(1.5rem, 2.2vw, 2rem) clamp(1.25rem, 2vw, 1.75rem);
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .steps__title { font-size: var(--step-0); font-weight: 600; letter-spacing: -0.01em; }

  .steps__copy { font-size: var(--step--1); color: var(--ink-2); line-height: 1.6; }

  /* coverage */
  .cover { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }

  @media (min-width: 62rem) {
    .cover { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  }

  .cover__title {
    font-size: var(--step-3);
    margin: 1.25rem 0 1.75rem;
    max-width: 24ch;
  }

  .cover__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .cover__list li {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
</style>
