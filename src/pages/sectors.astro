---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import Figure from '../components/Figure.astro';

const detail = [
  {
    n: '01',
    title: 'Commercial',
    lede: 'Offices, retail and workplace refurbishment, usually with the building still in use.',
    body: [
      'Cat A and Cat B fit-out, landlord works, dilapidations and end-of-lease reinstatement. The majority of our commercial work is phased: one floor or one wing at a time, with a dust-sealed line between us and the people still at their desks.',
      'Where noise is the constraint, the noisy operations get programmed into evenings and weekends and priced that way from the start, rather than appearing as a variation halfway through.',
    ],
    facts: [
      ['Typical duration', '2–10 weeks'],
      ['Working pattern', 'Phased or out-of-hours'],
      ['Handover', 'Snag list, O&M file, keys'],
    ],
  },
  {
    n: '02',
    title: 'Education',
    lede: 'Schools, colleges and nurseries, with the programme built around the academic calendar.',
    body: [
      'Summer is the busy season: six weeks to strip and rebuild washroom blocks, re-floor corridors, redecorate whole blocks and get the site handed back before the first day of term. That deadline is not negotiable, so the programme is written backwards from it.',
      'Teams working on school sites are enhanced DBS checked, inducted on safeguarding, and set up with segregated access, separate welfare and signed-in deliveries.',
    ],
    facts: [
      ['Typical window', 'Half term / summer'],
      ['Checks', 'Enhanced DBS, CSCS'],
      ['Site setup', 'Segregated access and welfare'],
    ],
  },
  {
    n: '03',
    title: 'Industrial',
    lede: 'Warehouses, depots and light industrial units that cannot stop operating.',
    body: [
      'Office and welfare blocks inside working sheds, heavy-duty floor systems, protective coatings, mezzanine fit-out and partitioned storage. Working alongside live plant and MHE traffic means a method statement that is read rather than filed.',
      'We are comfortable with permit-to-work systems, induction regimes and shift patterns that put us on site at four in the morning if that is when the floor is clear.',
    ],
    facts: [
      ['Working pattern', 'Live site, shift-based'],
      ['Floors', 'Resin, heavy-duty vinyl, screed'],
      ['Compliance', 'RAMS, permits, inductions'],
    ],
  },
  {
    n: '04',
    title: 'Residential',
    lede: 'Private houses and residential blocks, from one bathroom to a whole-house programme.',
    body: [
      'Full refurbishments, bathrooms and wet rooms, flooring, heating replacement and decoration. For private clients the difference tends to be communication rather than construction: a named contact, a weekly update, and a tidy site at the end of each day.',
      'For managing agents and freeholders we also take on communal areas — stairwells, entrance halls, corridor flooring and redecoration cycles.',
    ],
    facts: [
      ['Typical duration', '1–12 weeks'],
      ['Contact', 'Named supervisor, direct number'],
      ['Guarantee', 'Workmanship warranty on handover'],
    ],
  },
];
---

<Base
  title="Sectors"
  description="Commercial, education, industrial and residential building work across Kent, London and the South East — how RB Interiors (Kent) approaches each one."
>
  <PageHero
    eyebrow="Sectors"
    title="Four kinds of building, four ways of working."
    lede="The trades do not change much between a school and a warehouse. The constraints do — who is in the building, when we can be noisy, and which date is immovable."
  />

  {detail.map((s) => (
    <section class="sec">
      <div class="wrap sec__inner">
        <div class="sec__head">
          <span class="num">{s.n}</span>
          <h2 class="sec__title">{s.title}</h2>
          <p class="sec__lede">{s.lede}</p>
        </div>

        <div class="sec__body prose">
          {s.body.map((p) => <p>{p}</p>)}
        </div>

        <dl class="sec__facts">
          {s.facts.map(([k, v]) => (
            <div class="sec__fact">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  ))}

  <section class="section ruled">
    <div class="wrap gal">
      <div>
        <p class="label">Recent work</p>
        <h2 class="gal__title">A photographic record, once the dust settles.</h2>
        <p class="prose">
          We are rebuilding this section with properly shot before-and-after
          sets from the last two years. In the meantime, ask and we will send
          references and photographs for work comparable to yours.
        </p>
      </div>
      <div class="gal__grid">
        <Figure caption="Fig. 02 — Cat B office fit-out, Maidstone" ratio="1 / 1" />
        <Figure caption="Fig. 03 — Corridor re-floor, Swale" ratio="1 / 1" />
        <Figure caption="Fig. 04 — Welfare block, Isle of Grain" ratio="1 / 1" />
        <Figure caption="Fig. 05 — Whole-house refurbishment, Canterbury" ratio="1 / 1" />
      </div>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .sec {
    padding-block: clamp(2.75rem, 5.5vw, 5rem);
    border-bottom: 1px solid var(--rule);
  }

  .sec__inner { display: grid; gap: clamp(1.75rem, 3.5vw, 3.5rem); }

  @media (min-width: 64rem) {
    .sec__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .sec__head { display: grid; gap: 0.9rem; align-content: start; }
  .sec__title { font-size: var(--step-3); }
  .sec__lede {
    color: var(--ink-3);
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 32ch;
  }

  .sec__body p + p { margin-top: 1em; }

  .sec__facts { margin: 0; border-top: 1px solid var(--rule); }

  .sec__fact {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .sec__fact dt {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .sec__fact dd { margin: 0; font-size: var(--step--1); }

  .gal { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }

  @media (min-width: 64rem) {
    .gal { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  }

  .gal__title { font-size: var(--step-3); margin: 1.25rem 0 1.5rem; max-width: 22ch; }

  .gal__grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
</style>
