---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import { services } from '../data/site';
---

<Base
  title="Services"
  description="Refurbishment and fit-out, partitioning and suspended ceilings, joinery, flooring, plumbing and heating, bathrooms and washrooms, painting and decorating — all delivered in-house by RB Interiors (Kent)."
>
  <PageHero
    eyebrow="Services"
    title="Seven trades we do not subcontract."
    lede="Each of these runs as its own team with its own supervisor. Most jobs use three or four of them at once, which is the whole point — the coordination between them is our problem, not yours."
  />

  <nav class="jump" aria-label="Jump to a service">
    <div class="wrap jump__inner">
      {services.map((s) => (
        <a class="jump__link" href={`#${s.slug}`}>
          <span class="num">{s.n}</span> {s.title}
        </a>
      ))}
    </div>
  </nav>

  {services.map((s, i) => (
    <section id={s.slug} class:list={['svc', i % 2 === 1 && 'svc--alt']}>
      <div class="wrap svc__inner">
        <div class="svc__head">
          <span class="num">{s.n}</span>
          <h2 class="svc__title">{s.title}</h2>
          <p class="svc__sum">{s.summary}</p>
        </div>

        <div class="svc__body">
          <p class="svc__detail">{s.detail}</p>
        </div>

        <div class="svc__list">
          <h3 class="svc__list-head">Typically includes</h3>
          <ul>
            {s.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <CallToAction
    heading="Not sure which of those you need?"
    copy="Most people describe the problem rather than the trade — a floor that keeps lifting, a room that is too loud, a washroom that is past saving. Tell us the problem and we will tell you what the work actually is."
  />
</Base>

<style>
  .jump {
    position: sticky;
    top: 4.75rem;
    z-index: 20;
    background: var(--paper-2);
    border-bottom: 1px solid var(--rule);
  }

  .jump__inner {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    padding-block: 0.9rem;
    scrollbar-width: none;
  }
  .jump__inner::-webkit-scrollbar { display: none; }

  .jump__link {
    display: flex;
    gap: 0.5rem;
    white-space: nowrap;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .jump__link:hover { color: var(--accent-ink); }

  .svc {
    padding-block: clamp(2.75rem, 5.5vw, 5rem);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 9rem;
  }

  .svc--alt { background: var(--paper-2); }

  .svc__inner {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3.5rem);
  }

  @media (min-width: 64rem) {
    .svc__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 0.85fr);
      align-items: start;
    }
  }

  .svc__head { display: grid; gap: 0.9rem; align-content: start; }

  .svc__title { font-size: var(--step-2); max-width: 18ch; }

  .svc__sum {
    color: var(--ink-3);
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 34ch;
  }

  .svc__detail {
    font-size: var(--step-1);
    line-height: 1.5;
    letter-spacing: -0.012em;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .svc__list-head {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .svc__list ul { display: grid; }

  .svc__list li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
</style>
