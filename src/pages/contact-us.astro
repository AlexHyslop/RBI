---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import { company, services } from '../data/site';
---

<Base
  title="Contact Us"
  description={`Contact RB Interiors (Kent) Limited. Call ${company.phone} or email ${company.email} for building and refurbishment work across the South East.`}
>
  <PageBanner
    title="Contact Us"
    lede="Tell us where the building is and what needs doing. We will come and look before pricing anything substantial."
    photo="/photos/commercial.jpg"
  />

  <section class="section">
    <div class="wrap contact">
      <div class="contact__side" data-reveal>
        <p class="eyebrow">Get in touch</p>
        <h2 class="contact__title">Speak to Richard.</h2>
        <p class="prose">
          Calls go straight to the person who will come and look at the job, not
          to a switchboard. If we are not the right firm for your work, we will
          usually know within five minutes and say so.
        </p>

        <dl class="details">
          <div>
            <dt>Telephone</dt>
            <dd><a href={company.phoneHref}>{company.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>Area covered</dt>
            <dd>{company.area}</dd>
          </div>
          <div>
            <dt>Company</dt>
            <dd>{company.name}, no. {company.companyNumber}</dd>
          </div>
        </dl>

        <div class="tags">
          <p class="tags__label">We can help with</p>
          <ul>
            {services.map((s) => (
              <li><a href={`/our-services/#${s.slug}`}>{s.title}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="contact__form" data-reveal>
        <h2 class="form__title">Send a message</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="band" aria-hidden="true">
    <img
      class="band__img"
      src="/photos/band.jpg"
      alt=""
      width="2000"
      height="857"
      loading="lazy"
    />
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .contact { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .contact__title { font-size: var(--step-3); margin-bottom: 1.5rem; }

  .details { margin: 2.5rem 0 0; }

  .details > div {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-top: 2px solid var(--grey-line);
  }

  @media (min-width: 30rem) {
    .details > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .details dt {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }

  .details dd { margin: 0; font-size: var(--step-1); font-weight: 700; color: var(--navy); }
  .details dd a:hover { text-decoration: underline; text-underline-offset: 0.3em; }

  .tags { margin-top: 2.5rem; }

  .tags__label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey-mid);
    margin-bottom: 1rem;
  }

  .tags ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .tags a {
    display: block;
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--grey-line);
    font-size: var(--step--1);
    font-weight: 600;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .tags a:hover { border-color: var(--navy); color: var(--navy); }

  .contact__form { background: var(--off); padding: clamp(1.5rem, 3.5vw, 3rem); }

  .form__title { font-size: var(--step-2); margin-bottom: 2rem; }

  .band__img {
    width: 100%;
    height: clamp(12rem, 24vw, 20rem);
    object-fit: cover;
  }
</style>
