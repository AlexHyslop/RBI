---
/**
 * Image slot. Drop a real photograph into /public/photos and pass `src`;
 * until then the slot renders as a deliberate hatched plate with its caption,
 * so an un-photographed page still reads as finished rather than broken.
 */
interface Props {
  caption: string;
  src?: string;
  alt?: string;
  ratio?: string;
  class?: string;
}

const { caption, src, alt = '', ratio = '4 / 3', class: className } = Astro.props;
---

<figure class:list={['plate', className]} style={`--ratio: ${ratio}`}>
  {src ? (
    <img class="plate__img" src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <div class="plate__empty hatch" aria-hidden="true">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="plate__cross">
        <line x1="0" y1="0" x2="100" y2="100" vector-effect="non-scaling-stroke" />
        <line x1="100" y1="0" x2="0" y2="100" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  )}
  <figcaption class="plate__cap">{caption}</figcaption>
</figure>

<style>
  .plate { margin: 0; }

  .plate__img,
  .plate__empty {
    aspect-ratio: var(--ratio);
    width: 100%;
    border: 1px solid var(--rule);
    object-fit: cover;
  }

  .plate__empty { position: relative; }

  .plate__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--rule);
    stroke-width: 1;
    opacity: 0.6;
  }

  .plate__cap {
    display: block;
    margin-top: 0.85rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
