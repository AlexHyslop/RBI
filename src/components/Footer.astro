---
import { company, nav, services } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__brand">
        <img
          class="foot__logo"
          src="/logo-white.png"
          alt={company.name}
          width="881"
          height="193"
          loading="lazy"
        />
        <p class="foot__statement">
          A comprehensive range of professional building services across the
          South East.
        </p>
        <a class="btn btn--light" href="/contact-us/">
          Get in touch <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="foot__cols">
        <div class="foot__col">
          <h2 class="foot__head">Quick Links</h2>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>

        <div class="foot__col">
          <h2 class="foot__head">Services</h2>
          <ul>
            {services.map((s) => (
              <li><a href={`/our-services/#${s.slug}`}>{s.title}</a></li>
            ))}
          </ul>
        </div>

        <div class="foot__col">
          <h2 class="foot__head">Contact</h2>
          <ul>
            <li><a href={company.phoneHref}>{company.phone}</a></li>
            <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
            <li class="foot__plain">{company.area}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="foot__bottom">
      <p>© {year} {company.name}</p>
      <p>Registered in England &amp; Wales, no. {company.companyNumber}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--grey);
    color: var(--white);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
  }

  .foot__top {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  @media (min-width: 62rem) {
    .foot__top { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
  }

  .foot__logo { width: clamp(190px, 22vw, 270px); height: auto; }

  .foot__statement {
    margin: 2rem 0;
    max-width: 22ch;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .foot__cols {
    display: grid;
    gap: 2.5rem clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .foot__head {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 1.25rem;
  }

  .foot__col ul { display: grid; gap: 0.7rem; }
  .foot__col a { opacity: 0.9; }
  .foot__col a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 0.3em; }
  .foot__plain { opacity: 0.7; }

  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: var(--step--1);
    opacity: 0.7;
  }

  .foot__bottom p { margin: 0; }
</style>
