---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 152 34"
  role="img"
  aria-label="RB Interiors (Kent)"
  width="152"
  height="34"
>
  <!-- mark: three stacked bays, the middle one picked out in the accent -->
  <rect x="0.5" y="0.5" width="31" height="33" fill="none" stroke="currentColor" stroke-width="1" />
  <rect x="4" y="4" width="24" height="7" fill="currentColor" />
  <rect x="4" y="13.5" width="24" height="7" fill="var(--accent)" />
  <rect x="4" y="23" width="24" height="7" fill="currentColor" />
  <text
    x="42"
    y="18"
    fill="currentColor"
    font-family="var(--sans)"
    font-size="19"
    font-weight="700"
    letter-spacing="-0.5"
  >RBI</text>
  <text
    x="42"
    y="30"
    fill="currentColor"
    font-family="var(--mono)"
    font-size="7.4"
    font-weight="500"
    letter-spacing="1.5"
    opacity="0.72"
  >KENT · EST. 2012</text>
</svg>
