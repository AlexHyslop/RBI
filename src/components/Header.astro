---
import Logo from './Logo.astro';
import { company, nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<header class="site-head">
  <div class="wrap site-head__inner">
    <a href="/" class="site-head__brand" aria-label={`${company.name} — home`}>
      <Logo class="site-head__logo" />
    </a>

    <button
      class="site-head__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="site-head__toggle-label">Menu</span>
      <span class="site-head__bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="site-nav__link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <a class="site-head__phone" href={company.phoneHref}>
        <span class="site-head__phone-label">Call</span>
        <span class="site-head__phone-num">{company.phone}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .site-head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.75rem;
  }

  .site-head__brand {
    text-decoration: none;
    display: block;
    flex: none;
  }

  .site-head__logo {
    width: 136px;
    height: auto;
    color: var(--ink);
  }

  .site-head__toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: 1px solid var(--rule);
    padding: 0.5rem 0.75rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
  }

  .site-head__bars {
    display: grid;
    gap: 4px;
    width: 15px;
  }
  .site-head__bars i {
    display: block;
    height: 1.5px;
    background: var(--ink);
    transition: translate 0.2s ease, rotate 0.2s ease;
  }
  [aria-expanded='true'] .site-head__bars i:first-child { translate: 0 2.75px; rotate: 45deg; }
  [aria-expanded='true'] .site-head__bars i:last-child { translate: 0 -2.75px; rotate: -45deg; }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
  }

  .site-nav__link {
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
    white-space: nowrap;
  }

  .site-nav__link:hover { color: var(--ink); border-bottom-color: var(--accent); }
  .site-nav__link[aria-current='page'] { color: var(--ink); border-bottom-color: var(--ink); }

  .site-head__phone {
    display: grid;
    text-decoration: none;
    padding-left: clamp(1rem, 2vw, 2rem);
    border-left: 1px solid var(--rule);
  }

  .site-head__phone-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .site-head__phone-num {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .site-head__phone:hover .site-head__phone-num { color: var(--accent-ink); }

  @media (max-width: 62rem) {
    .site-head__toggle { display: inline-flex; }

    .site-nav {
      position: absolute;
      inset: 100% 0 auto;
      display: grid;
      gap: 0;
      align-items: stretch;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 0 var(--gutter) 1.5rem;
      box-shadow: 0 18px 40px -28px rgba(21, 23, 26, 0.5);
    }

    .site-nav:not([data-open]) { display: none; }

    .site-nav__list { display: grid; }

    .site-nav__link {
      display: block;
      padding-block: 1rem;
      border-bottom: 1px solid var(--rule);
      font-size: var(--step-0);
    }
    .site-nav__link[aria-current='page'] { border-bottom-color: var(--accent); }

    .site-head__phone {
      padding: 1.25rem 0 0;
      border-left: 0;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('site-nav');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = panel.hasAttribute('data-open');
      panel.toggleAttribute('data-open', !open);
      toggle.setAttribute('aria-expanded', String(!open));
    });

    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        panel.removeAttribute('data-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
