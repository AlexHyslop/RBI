---
import { sectors } from '../data/site';
---

<ul class="tiles">
  {sectors.map((s) => (
    <li class="tile" data-reveal>
      <img class="tile__img" src={s.photo} alt="" width="1400" height="1050" loading="lazy" />
      <div class="tile__body">
        <h3 class="tile__title">{s.title}</h3>
        <p class="tile__copy">{s.copy}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  @media (min-width: 46rem) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 86rem) {
    .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .tile {
    position: relative;
    display: grid;
    align-items: end;
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
    isolation: isolate;
  }

  .tile__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Washed back until hover, as on the reference layout. */
    filter: grayscale(0.55) brightness(1.08);
    transition: scale 0.7s var(--ease), filter 0.5s var(--ease);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.5) 40%,
      rgba(21, 41, 80, 0.72) 100%
    );
    transition: background 0.5s var(--ease);
  }

  .tile:hover .tile__img { scale: 1.05; filter: grayscale(0) brightness(1); }

  .tile:hover::after {
    background: linear-gradient(
      180deg,
      rgba(21, 41, 80, 0.3) 0%,
      rgba(21, 41, 80, 0.45) 40%,
      rgba(21, 41, 80, 0.92) 100%
    );
  }

  .tile__body { padding: clamp(1.5rem, 2.5vw, 2.5rem); }

  .tile__title {
    font-size: var(--step-2);
    color: var(--white);
    text-shadow: 0 1px 14px rgba(21, 41, 80, 0.55);
  }

  .tile__copy {
    margin: 0.75rem 0 0;
    max-width: 30ch;
    color: var(--white);
    font-size: var(--step--1);
    line-height: 1.55;
    opacity: 0;
    translate: 0 0.5rem;
    transition: opacity 0.4s var(--ease), translate 0.4s var(--ease);
  }

  .tile:hover .tile__copy,
  .tile:focus-within .tile__copy { opacity: 1; translate: 0 0; }

  /* Touch screens have no hover, so show everything up front. */
  @media (hover: none) {
    .tile__img { filter: grayscale(0) brightness(1); }
    .tile::after {
      background: linear-gradient(
        180deg,
        rgba(21, 41, 80, 0.25) 0%,
        rgba(21, 41, 80, 0.45) 40%,
        rgba(21, 41, 80, 0.9) 100%
      );
    }
    .tile__copy { opacity: 1; translate: 0 0; }
  }
</style>
