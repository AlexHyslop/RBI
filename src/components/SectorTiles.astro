---
import { sectors } from '../data/site';
---

<ul class="tiles">
  {sectors.map((s) => (
    <li class="tile" data-reveal>
      <img class="tile__img" src={s.photo} alt="" width="1400" height="1050" loading="lazy" />
      <div class="tile__body">
        <h3 class="tile__title">{s.title}</h3>
        <div class="tile__reveal"><p class="tile__copy">{s.copy}</p></div>
      </div>
    </li>
  ))}
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  /* Five sectors divide badly into an even grid, so the odd one out runs
     wide instead of leaving a hole: 2 + 2 + 1 at tablet, 3 + 2 at desktop.
     Both rules assume five tiles — revisit them if that number changes. */
  @media (min-width: 46rem) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile:last-child { grid-column: 1 / -1; aspect-ratio: 16 / 6; }
  }

  @media (min-width: 86rem) {
    .tiles { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tile { grid-column: span 2; }
    .tile:nth-child(4),
    .tile:last-child { grid-column: span 3; aspect-ratio: 16 / 7; }
  }

  .tile {
    position: relative;
    display: grid;
    align-items: end;
    aspect-ratio: 4 / 3.2;
    overflow: hidden;
    isolation: isolate;
  }

  .tile__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Washed back until hover, as on the reference layout. */
    filter: grayscale(0.55) brightness(1.08);
    transition: scale 0.7s var(--ease), filter 0.5s var(--ease);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.5) 40%,
      rgba(21, 41, 80, 0.72) 100%
    );
    transition: background 0.5s var(--ease);
  }

  .tile:hover .tile__img { scale: 1.05; filter: grayscale(0) brightness(1); }

  .tile:hover::after {
    background: linear-gradient(
      180deg,
      rgba(21, 41, 80, 0.3) 0%,
      rgba(21, 41, 80, 0.45) 40%,
      rgba(21, 41, 80, 0.92) 100%
    );
  }

  .tile__body { padding: clamp(1.5rem, 2.5vw, 2.5rem); }

  .tile__title {
    font-size: var(--step-2);
    color: var(--white);
    text-shadow: 0 1px 14px rgba(21, 41, 80, 0.55);
  }

  /* Collapsing the copy to zero height rather than just fading it keeps
     every title on the same baseline, whatever the copy length. */
  .tile__reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.45s var(--ease), opacity 0.35s var(--ease);
  }

  .tile__reveal > * { overflow: hidden; }

  .tile:hover .tile__reveal,
  .tile:focus-within .tile__reveal { grid-template-rows: 1fr; opacity: 1; }

  .tile__copy {
    margin: 0.75rem 0 0;
    max-width: 34ch;
    color: var(--white);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* Touch screens have no hover, so show everything up front. */
  @media (hover: none) {
    .tile__img { filter: grayscale(0) brightness(1); }
    .tile::after {
      background: linear-gradient(
        180deg,
        rgba(21, 41, 80, 0.25) 0%,
        rgba(21, 41, 80, 0.45) 40%,
        rgba(21, 41, 80, 0.9) 100%
      );
    }
    .tile__reveal { grid-template-rows: 1fr; opacity: 1; }
  }
</style>
