---
interface Props {
  title: string;
  lede?: string;
  photo: string;
}
const { title, lede, photo } = Astro.props;
---

<section class="banner">
  <img class="banner__img" src={photo} alt="" width="1400" height="1050" />
  <div class="banner__scrim"></div>
  <div class="wrap banner__inner">
    <h1 class="banner__title">{title}</h1>
    {lede && <p class="banner__lede">{lede}</p>}
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(20rem, 42vw, 30rem);
    margin-top: calc(var(--header-h) * -1);
    isolation: isolate;
    overflow: hidden;
  }

  .banner__img,
  .banner__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .banner__img { width: 100%; height: 100%; object-fit: cover; }

  .banner__scrim {
    background: linear-gradient(
      180deg,
      rgba(21, 41, 80, 0.82) 0%,
      rgba(21, 41, 80, 0.62) 45%,
      rgba(21, 41, 80, 0.86) 100%
    );
  }

  .banner__inner {
    color: var(--white);
    padding-block: calc(var(--header-h) + 2.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .banner__title { font-size: var(--step-4); max-width: 18ch; }

  .banner__lede {
    margin: 1.5rem 0 0;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.45;
    max-width: 46ch;
    opacity: 0.92;
  }
</style>
