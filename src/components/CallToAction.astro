---
import { company } from '../data/site';

interface Props {
  heading?: string;
  copy?: string;
}

const {
  heading = 'Got a building that needs work?',
  copy = 'Send over a drawing, a schedule or a few photographs on your phone. We will tell you honestly whether it is a job for us, and what it is likely to cost.',
} = Astro.props;
---

<section class="cta ink-panel">
  <div class="wrap cta__inner">
    <div>
      <p class="label">Next step</p>
      <h2 class="cta__head">{heading}</h2>
    </div>
    <div class="cta__body">
      <p class="prose">{copy}</p>
      <div class="cta__actions">
        <a class="btn btn--invert" href="/contact/">
          Request a quotation <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="cta__tel" href={company.phoneHref}>or call {company.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(3rem, 6vw, 6rem); }

  .cta__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  @media (min-width: 60rem) {
    .cta__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .cta__head {
    margin-top: 1.5rem;
    font-size: var(--step-3);
    max-width: 20ch;
  }

  .cta__body { display: grid; align-content: start; gap: 2rem; }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .cta__tel {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration-color: var(--rule);
  }
  .cta__tel:hover { color: var(--paper); }
</style>
